rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile originals stay in the signed-in user's folder.
    // Other people never get a Storage read here. Approved photos are published
    // as download-token URLs written by Cloud Functions onto the public profile.
    match /users/{uid}/photos/{photoId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Verification selfies. The owner can upload once. Other users cannot read.
    // Cloud Functions delete the file after a decision. Clients cannot delete or replace it.
    match /users/{uid}/verification/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if false;
    }
  }
}
