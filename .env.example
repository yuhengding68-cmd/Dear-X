# Data mode is required when Firebase is not configured.
# demo  = in-browser mock data. This is explicit. The app will not choose it for you.
# firebase = Cloud Firestore + Auth + Cloud Functions. Requires the web config below.
VITE_DATA_MODE=demo

# Firebase web config. Required when VITE_DATA_MODE=firebase.
# Do not put server secrets here. These values are the public web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# App Check. Public site key from Firebase console, not a server secret.
# Leave blank until you register the web app. Provider is enterprise or v3.
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_APPCHECK_PROVIDER=enterprise
# Local debug only. Do not commit a real debug token.
# VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Cloud Functions env (functions/.env, not this file):
# ENFORCE_APP_CHECK=true   after App Check is registered and enforced in the console.

# Server-only. Set with Firebase Functions secrets, never in Vite:
#   firebase functions:secrets:set GEMINI_API_KEY
# Optional function env:
#   KYC_VENDOR=didit          (or veriff) — stub until a vendor key exists
#   KYC_MODE=live             — disables the identity-check simulation callable
